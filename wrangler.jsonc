{
  "name": "elio-website",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "preview_urls": true,
  "build": { "command": "node scripts/build-assets.mjs" },
  "assets": {
    "directory": "./.release",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index", "/index.html", "/order", "/order.html", "/order/", "/story", "/story.html", "/story/", "/flavors", "/flavors.html", "/flavors/", "/box", "/box.html", "/box/"]
  },
  "routes": [
    {
      "pattern": "eliocheesecakes.com",
      "custom_domain": true
    }
  ]
}
